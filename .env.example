# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Default is SQLite for instant zero-config local run:
DATABASE_URL="file:./dev.db"
# For PostgreSQL production, use:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/tradevision?schema=public"

# Authentication
JWT_SECRET=tradevision_super_secret_jwt_key_2025_prod_secure

# Optional API Keys (Real Market Data works out of the box via public providers like Binance & Yahoo Finance)
MARKET_DATA_API_KEY=
# Optional AI Key (Google Gemini or OpenAI API key; when empty, the built-in Quantitative AI engine is used)
AI_API_KEY=
